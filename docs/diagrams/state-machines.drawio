        <mxCell id="boot" value="&lt;b&gt;Boot / 初始化&lt;/b&gt;&lt;br&gt;先读 RTC AF，再清标志&lt;br&gt;USB：额外 ≤10s 串口校时窗口" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=19;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="590" y="125" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="route" value="&lt;b&gt;启动路由&lt;/b&gt;&lt;br&gt;AF=0（非RTC启动）或中键GPIO5&lt;br&gt;或上键GPIO4 → 用户服务" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=19;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="590" y="290" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="service" value="&lt;b&gt;用户服务 · 详见 BLE / LAN 图&lt;/b&gt;&lt;br&gt;上键 / 无保存SSID → BLE&lt;br&gt;否则 → STA HTTP&lt;br&gt;BLE失败 → 结束服务、回时钟&lt;br&gt;BLE保存成功 → 先尝试NTP&lt;br&gt;NTP失败也继续 → STA HTTP" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=18;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#f3ecfa;strokeColor=#8054a6;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="300" width="380" height="205" as="geometry" />
        </mxCell>
        <mxCell id="daily" value="&lt;b&gt;每日自动校时检查&lt;/b&gt;&lt;br&gt;条件 / 当天尝试锁定：详见 NTP 图" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=19;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="590" y="480" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="refresh" value="&lt;b&gt;采样 → 刷屏 → 更新缓存&lt;/b&gt;&lt;br&gt;EPD_Init → ALDO3 3.3V开&lt;br&gt;刷完 EPD_Sleep → ALDO3关&lt;br&gt;校时成功可请求强制全刷" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=18;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="590" y="655" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;本轮处理是否已跨整分？&lt;/b&gt;&lt;br&gt;是：立即再次每日检查 / 补刷" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=19;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="590" y="825" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="off" value="&lt;b&gt;电池：设下分钟 RTC → PMU关机&lt;/b&gt;&lt;br&gt;WiFi / HTTP / BLE 均关闭&lt;br&gt;等待 RTC / PWR 冷启动" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=18;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#f0f2f5;strokeColor=#647080;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="250" y="995" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="usb" value="&lt;b&gt;USB：时钟等待整分&lt;/b&gt;&lt;br&gt;每50ms查键；整分到达后更新&lt;br&gt;WiFi / HTTP / BLE 均关闭" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=18;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="950" y="995" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="missing" value="&lt;b&gt;尚未实现（不是转换）&lt;/b&gt;&lt;br&gt;常驻LAN / WiFi掉线重连&lt;br&gt;LAN失败屏幕提示仍欠缺&lt;br&gt;不得据此理解为自动热点" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=18;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#fff0ee;strokeColor=#b73838;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="85" y="345" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="clock_note" value="&lt;b&gt;屏幕断电仍保留画面&lt;/b&gt;&lt;br&gt;USB / HTTP / BLE等待：屏幕电源关&lt;br&gt;屏幕断电 ≠ PMU整机关机&lt;br&gt;可与LAN常驻共存（但尚未实现）" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=18;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="85" y="620" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="edge_1_label" value="读取启动来源" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=17;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;text;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
