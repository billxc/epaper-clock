        <mxCell id="request" value="&lt;b&gt;UserRequest / 用户服务入口&lt;/b&gt;&lt;br&gt;上键或无保存SSID：需要BLE&lt;br&gt;否则直接进入LAN" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=18;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
