        </mxCell>
        <mxCell id="advertise" value="&lt;b&gt;广播 / 等待凭据&lt;/b&gt;&lt;br&gt;Security1 + 6位PoP码&lt;br&gt;PoP失败不提交WiFi；继续等待" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=19;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#f3ecfa;strokeColor=#8054a6;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="620" y="150" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lan" value="&lt;b&gt;无需BLE → LAN&lt;/b&gt;&lt;br&gt;STA HTTP；详见 LAN 图" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=19;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="connect" value="&lt;b&gt;候选 WiFi 有限连接&lt;/b&gt;&lt;br&gt;SDK 最多3次连接尝试&lt;br&gt;失败且预算内：重置失败状态" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=19;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#f3ecfa;strokeColor=#8054a6;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="620" y="370" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="verified" value="&lt;b&gt;取得IP / CRED_SUCCESS&lt;/b&gt;&lt;br&gt;锁存 success；后续FAIL不清零&lt;br&gt;仅验证成功 ≠ 已保存 clock_net" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=18;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#e9f6ed;strokeColor=#287747;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="620" y="590" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cleanup" value="&lt;b&gt;结束配网会话&lt;/b&gt;&lt;br&gt;停止BLE；清除SDK临时WiFi数据" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=18;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#f3ecfa;strokeColor=#8054a6;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="620" y="800" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="save" value="&lt;b&gt;持久化候选凭据&lt;/b&gt;&lt;br&gt;写入 clock_net" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=19;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="620" y="975" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="success" value="&lt;b&gt;保存成功 → run_management&lt;/b&gt;&lt;br&gt;先尝试NTP（失败也继续）&lt;br&gt;再进入 STA HTTP / LAN" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=18;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#e9f6ed;strokeColor=#287747;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="1180" y="970" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="&lt;b&gt;失败结束 → 返回时钟&lt;/b&gt;&lt;br&gt;未验证WiFi失败：不写clock_net&lt;br&gt;初始化 / 清理错误：保留旧配置&lt;br&gt;NVS保存失败：可能部分写入" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=17;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#fff0ee;strokeColor=#b73838;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="80" y="800" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="disconnect_note" value="&lt;b&gt;网页断开 ≠ 取消&lt;/b&gt;&lt;br&gt;已提交的配网工作仍可能保存成功&lt;br&gt;不画“网页断开 → 失败”转换" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=17;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="80" y="570" width="360" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sdk_note" value="&lt;b&gt;SDK内部过程为抽象状态&lt;/b&gt;&lt;br&gt;CRED_SUCCESS / END 为SDK事件&lt;br&gt;取得IP只锁存验证结果&lt;br&gt;只有后续写 clock_net 才算保存成功" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=17;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#eaf2ff;strokeColor=#2563a8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="1180" y="390" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="deadline_note" value="&lt;b&gt;活动deadline = 函数入口 + 295s&lt;/b&gt;&lt;br&gt;预留5s清理；并非硬实时期限&lt;br&gt;已锁存success时到deadline&lt;br&gt;仍可能清理后保存新配置" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=17;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#f3ecfa;strokeColor=#8054a6;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="1180" y="590" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="persistence_note" value="&lt;b&gt;持久化边界：非原子事务&lt;/b&gt;&lt;br&gt;network_save_config 顺序写多个key&lt;br&gt;NVS保存失败可能已部分写入&lt;br&gt;不保证回滚 / 保留完整旧配置" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=17;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;rounded=1;arcSize=10;fillColor=#fff0ee;strokeColor=#b73838;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="1180" y="790" width="350" height="130" as="geometry" />
        </mxCell>
