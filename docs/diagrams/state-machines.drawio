        <mxCell id="legend" value="蓝：正常  ·  绿：成功  ·  红：失败&lt;br&gt;紫：BLE  ·  灰：关机  |  实线仅表示已实现转换" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif;fontSize=17;fontColor=#172b44;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;" vertex="1" parent="1">
